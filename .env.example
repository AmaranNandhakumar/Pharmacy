# Copy to .env (which git ignores) and change the passwords before running docker compose.

# SQL Server "sa" password: 8+ characters with upper, lower, digit and symbol
SA_PASSWORD=Change-Me-Sql1!

# JWT signing key: any random string of 32+ characters
JWT_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# The first Admin, created on the first start
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Change-Me-Admin1!

# true = fill the empty database with fake demo data on first start
SEED_DEMO=true
# Password for the demo pharmacist@demo.local and technician@demo.local accounts
DEMO_PASSWORD=Demo@Pass123

# Port for http://localhost:<port>
WEB_PORT=8080
